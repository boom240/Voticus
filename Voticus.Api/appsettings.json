{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Voticus",
    "LifetimeDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Storage": {
    "LocalPath": "App_Data/images"
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Vote": { "PermitLimit": 10, "WindowSeconds": 60 }
  },
  "Seed": {
    "Enabled": false
  }
}
